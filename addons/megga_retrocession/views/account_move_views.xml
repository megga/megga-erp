<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- L'apporteur d'affaires sur la facture client, dans « Autres
         informations » à côté des champs de vente : c'est lui qui fait
         entrer la facture dans un décompte « à verser ». -->
    <record id="view_move_form_retrocession" model="ir.ui.view">
        <field name="name">account.move.form.retrocession</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="referrer_id"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
