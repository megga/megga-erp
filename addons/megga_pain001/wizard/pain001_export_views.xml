<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="megga_pain001_export_wizard_form" model="ir.ui.view">
        <field name="name">megga.pain001.export.wizard.form</field>
        <field name="model">megga.pain001.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exporter en pain.001">
                <p class="text-muted">
                    Génère un fichier <b>pain.001.001.09.ch.03</b>
                    (Swiss Payment Standards) à déposer dans votre e-banking.
                    Les références QRR et RF (SCOR) présentes dans le mémo des
                    paiements sont détectées et validées automatiquement.
                </p>
                <group>
                    <field name="journal_id"/>
                    <field name="execution_date"/>
                    <field name="force_reexport"/>
                </group>
                <field name="payment_ids">
                    <list>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="partner_bank_id"/>
                        <field name="memo"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="state"/>
                    </list>
                </field>
                <footer>
                    <button name="action_export" type="object"
                            string="Générer le fichier" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_megga_pain001_export" model="ir.actions.act_window">
        <field name="name">Exporter en pain.001 (Suisse)</field>
        <field name="res_model">megga.pain001.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
    </record>

    <menuitem id="menu_megga_pain001_export"
              name="Export pain.001 (paiements)"
              parent="account.menu_finance_entries"
              action="action_megga_pain001_export"
              sequence="91"
              groups="account.group_account_user"/>

</odoo>
