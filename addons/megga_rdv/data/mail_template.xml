<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_rdv_confirmation" model="mail.template">
            <field name="name">RDV : confirmation de réservation</field>
            <field name="model_id" ref="model_megga_rdv_booking"/>
            <field name="subject">Votre rendez-vous {{ object.name }} est confirmé</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
<div style="font-family: sans-serif; font-size: 14px;">
    <p>Bonjour <t t-out="object.guest_name"/>,</p>
    <p>Votre rendez-vous est confirmé :</p>
    <p style="margin-left: 16px;">
        <strong t-out="object.type_id.name"/><br/>
        <t t-out="object._local_label()"/><br/>
        Référence : <t t-out="object.name"/>
    </p>
    <p>Un empêchement ? Annulez en un clic :
        <a t-att-href="object.get_base_url() + '/rdv/annuler/' + object.access_token">annuler ce rendez-vous</a>.
    </p>
    <p t-if="object.company_id" t-out="object.company_id.name"/>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
