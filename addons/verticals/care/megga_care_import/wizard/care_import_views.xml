<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_care_import_form" model="ir.ui.view">
        <field name="name">megga.care.import.form</field>
        <field name="model">megga.care.import</field>
        <field name="arch" type="xml">
            <form string="Reprise Office Maker">
                <div class="alert alert-info" role="alert"
                     invisible="state != 'draft'">
                    Ordre d'import : <b>clients</b>, puis
                    <b>prestataires</b>, puis <b>mandats</b>, puis
                    <b>événements</b> — chaque fichier peut être relancé
                    autant de fois que nécessaire : l'import met à jour,
                    il ne duplique jamais.
                </div>
                <group invisible="state != 'draft'">
                    <group>
                        <field name="kind" widget="radio"/>
                        <field name="file_data" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="encoding"/>
                        <field name="delimiter"/>
                    </group>
                </group>
                <field name="state" invisible="1"/>
                <field name="result" invisible="state != 'done'"
                       class="o_field_text" readonly="1"/>
                <footer>
                    <button name="action_import" type="object"
                            string="Importer" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Fermer" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_care_import" model="ir.actions.act_window">
        <field name="name">Reprise Office Maker</field>
        <field name="res_model">megga.care.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_care_import" name="Reprise Office Maker"
              parent="megga_care.menu_care_root"
              action="action_care_import" sequence="80"
              groups="megga_care.group_care_coordination"/>
</odoo>
