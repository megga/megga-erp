<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupes LPD de la conciergerie. Le parcours de santé d'un client
         est une donnée personnelle SENSIBLE (art. 5 let. c nLPD) : son
         accès doit être proportionné (art. 6) et sécurisé (art. 8).
         Deux rôles, taillés pour la trajectoire de la structure (une
         indépendante aujourd'hui, une assistance demain) :

         - Assistance : identité, mandats, agenda et facturation —
           JAMAIS le parcours de santé ;
         - Coordination : tout, parcours de santé compris (implique
           Assistance).

         La protection du champ médical est portée par groups= sur le
         champ lui-même (appliquée par l'ORM, pas seulement par les
         vues) ; sans aucun groupe conciergerie, aucun accès du tout. -->

    <record id="module_category_care" model="ir.module.category">
        <field name="name">Conciergerie médicale</field>
        <field name="sequence">26</field>
    </record>

    <record id="res_groups_privilege_care" model="res.groups.privilege">
        <field name="name">Conciergerie médicale</field>
        <field name="category_id" ref="module_category_care"/>
        <field name="sequence">26</field>
    </record>

    <record id="group_care_assistance" model="res.groups">
        <field name="name">Assistance</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_care"/>
        <!-- group_partner_manager : le client délègue son identité à
             res.partner, et les prestataires (médecins, laboratoires,
             pharmacies) sont des contacts ordinaires — tenir ce carnet
             d'adresses est précisément le métier de l'assistance. -->
        <field name="implied_ids"
               eval="[(4, ref('base.group_user')),
                      (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Identité, coordonnées, mandats, agenda et
facturation des clients — jamais le parcours de santé (données sensibles,
art. 5 nLPD).</field>
    </record>

    <record id="group_care_coordination" model="res.groups">
        <field name="name">Coordination</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_care"/>
        <field name="implied_ids" eval="[(4, ref('group_care_assistance'))]"/>
        <field name="comment">Accès complet au dossier client (parcours de
santé compris) et suppression de dossiers.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_care_coordination'))]"/>
    </record>
</odoo>
