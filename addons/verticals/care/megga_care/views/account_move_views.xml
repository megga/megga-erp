<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Depuis la pièce fournisseur, remonter aux événements de mandat
         qu'elle couvre — le rattachement se vérifie dans les deux sens. -->
    <record id="view_move_form_care" model="ir.ui.view">
        <field name="name">account.move.form.care</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_care_events" type="object"
                        class="oe_stat_button" icon="fa-briefcase"
                        invisible="care_event_count == 0">
                    <field name="care_event_count" widget="statinfo"
                           string="Événements"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
