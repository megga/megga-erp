<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Référentiel des types de prestation. Les deux drapeaux
             portent le métier : rétrocession (marge sur volume chez le
             laboratoire et la pharmacie), exclusion TVA (art. 21 al. 2
             ch. 3 LTVA — seule la pharmacie est imposable parmi les
             postes médicaux courants). -->
        <record id="service_type_consultation" model="megga.care.service.type">
            <field name="name">Consultation médicale</field>
            <field name="code">CONS</field>
            <field name="sequence">10</field>
            <field name="vat_exempt" eval="True"/>
        </record>
        <record id="service_type_laboratoire" model="megga.care.service.type">
            <field name="name">Laboratoire</field>
            <field name="code">LABO</field>
            <field name="sequence">20</field>
            <field name="vat_exempt" eval="True"/>
            <field name="retrocession" eval="True"/>
        </record>
        <record id="service_type_radiologie" model="megga.care.service.type">
            <field name="name">Radiologie</field>
            <field name="code">RADIO</field>
            <field name="sequence">30</field>
            <field name="vat_exempt" eval="True"/>
        </record>
        <record id="service_type_pharmacie" model="megga.care.service.type">
            <field name="name">Pharmacie</field>
            <field name="code">PHARM</field>
            <field name="sequence">40</field>
            <field name="retrocession" eval="True"/>
        </record>
        <record id="service_type_appareillage" model="megga.care.service.type">
            <field name="name">Appareillage médical</field>
            <field name="code">APPA</field>
            <field name="sequence">50</field>
        </record>
        <record id="service_type_hospitalisation" model="megga.care.service.type">
            <field name="name">Séjour hospitalier</field>
            <field name="code">HOSP</field>
            <field name="sequence">60</field>
            <field name="vat_exempt" eval="True"/>
        </record>
        <record id="service_type_accompagnement" model="megga.care.service.type">
            <field name="name">Accompagnement</field>
            <field name="code">ACCO</field>
            <field name="sequence">70</field>
        </record>

        <record id="activity_care_unbilled" model="mail.activity.type">
            <field name="name">Facturation à compléter</field>
            <field name="res_model">megga.care.mandate</field>
            <field name="icon">fa-exclamation-triangle</field>
        </record>

        <record id="ir_cron_care_unbilled" model="ir.cron">
            <field name="name">Conciergerie : mandats en retard de facturation</field>
            <field name="model_id" ref="model_megga_care_mandate"/>
            <field name="state">code</field>
            <field name="code">model._cron_care_unbilled()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
