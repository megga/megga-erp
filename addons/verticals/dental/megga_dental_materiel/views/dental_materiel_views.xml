<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le fauteuil n'avait qu'une liste éditable : montrer son
         matériel demande une fiche. Le module apporte donc le
         formulaire qui lui manquait, et ouvre l'action existante
         dessus — le fauteuil et ce qui l'entoure au même endroit. -->
    <!-- La liste des fauteuils est ÉDITABLE : cliquer une ligne l'édite
         sur place, et la fiche ne s'ouvre JAMAIS. Le formulaire que ce
         module apporte — son écran phare — serait resté injoignable
         depuis le menu « Fauteuils ». `open_form_view` est l'attribut
         du cœur pour ce cas exact (account, analytic l'utilisent) : il
         ajoute la flèche d'ouverture en bout de ligne, sans retirer
         l'édition rapide. -->
    <record id="view_dental_chair_list_materiel" model="ir.ui.view">
        <field name="name">megga.dental.chair.list.materiel</field>
        <field name="model">megga.dental.chair</field>
        <field name="inherit_id" ref="megga_dental.view_dental_chair_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="open_form_view">True</attribute>
            </xpath>
        </field>
    </record>

    <!-- Le compteur et l'onglet sont gardés par le gestionnaire
         d'équipements, et non par `base.group_user`, pour la même
         raison que le menu « Appareils » : la règle du cœur
         (`maintenance.equipment_rule_user`) ne montre à un employé
         ordinaire que les équipements dont il est SUIVEUR. Le
         compteur, lui, se calcule en `sudo`. Sans cette garde, le
         praticien lisait « 1 appareil » sur un onglet vide —
         vérifié par un test avant d'être corrigé. -->
    <record id="view_dental_chair_form" model="ir.ui.view">
        <field name="name">megga.dental.chair.form.materiel</field>
        <field name="model">megga.dental.chair</field>
        <field name="arch" type="xml">
            <form string="Fauteuil">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_megga_open_equipment"
                                type="object" class="oe_stat_button"
                                icon="fa-wrench"
                                groups="maintenance.group_equipment_manager">
                            <field name="equipment_count" widget="statinfo"
                                   string="Appareils"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Fauteuil"/>
                        <h1><field name="name" placeholder="Fauteuil 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="note"
                                   placeholder="Étage, équipement particulier…"/>
                        </group>
                    </group>
                    <notebook groups="maintenance.group_equipment_manager">
                        <page string="Matériel" name="equipment">
                            <field name="equipment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="serial_no" optional="show"/>
                                    <field name="technician_user_id"
                                           optional="show"/>
                                    <field name="warranty_date"
                                           optional="show"/>
                                    <field name="maintenance_open_count"
                                           string="Entretiens en cours"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Ce qui est installé autour de ce
                                fauteuil. Un fauteuil qui porte du
                                matériel ne se supprime plus : il
                                s'archive.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="megga_dental.action_dental_chair" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

    <!-- Le fauteuil sur la fiche de l'appareil : un champ, pas un
         écran. Le reste du formulaire du cœur ne bouge pas.

         Le champ n'est PAS gardé par un groupe, et c'est délibéré : le
         responsable technique d'un cabinet n'a pas forcément de rôle
         dentaire, et le lui cacher retirerait au module son seul geste
         d'écriture. Le prix est connu : dans une base partagée avec une
         autre verticale, un technicien non dentaire voit une case
         « Fauteuil » qui ne le concerne pas. Elle lui apparaît vide et
         jamais en erreur — le cœur rattrape l'absence de droit sur le
         référentiel des fauteuils (`Many2one.convert_to_read` renvoie
         False sur AccessError). Une case de trop vaut mieux qu'un
         registre qu'on ne peut plus tenir. -->
    <record id="view_equipment_form_dental" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.dental</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="chair_id"/>
            </xpath>
        </field>
    </record>

    <!-- Les équipements du cabinet, groupés par fauteuil : la question
         que le cabinet se pose vraiment (« qu'est-ce qui s'arrête si
         cet appareil part en réparation ? »). -->
    <record id="view_dental_equipment_list" model="ir.ui.view">
        <field name="name">megga.dental.materiel.equipment.list</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <list string="Matériel du cabinet" multi_edit="1">
                <field name="name"/>
                <field name="chair_id"/>
                <field name="category_id"/>
                <field name="serial_no" optional="show"/>
                <field name="technician_user_id" optional="show"
                       widget="many2one_avatar_user"/>
                <field name="assign_date" optional="hide"/>
                <field name="warranty_date" optional="show"/>
                <field name="maintenance_open_count"
                       string="Entretiens en cours"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dental_equipment_search" model="ir.ui.view">
        <field name="name">megga.dental.materiel.equipment.search</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <search string="Matériel du cabinet">
                <field name="name"/>
                <field name="serial_no"/>
                <field name="chair_id"/>
                <field name="category_id"/>
                <filter name="au_fauteuil" string="Rattaché à un fauteuil"
                        domain="[('chair_id', '!=', False)]"/>
                <filter name="hors_fauteuil" string="Local technique"
                        domain="[('chair_id', '=', False)]"/>
                <separator/>
                <filter name="sous_garantie" string="Sous garantie"
                        domain="[('warranty_date', '&gt;=', 'today')]"/>
                <separator/>
                <!-- Le cœur porte ce filtre dans SA vue de recherche ;
                     la nôtre la remplace, et sans lui un appareil
                     déclassé (archivé) devenait introuvable depuis
                     l'écran du cabinet — or c'est justement là qu'on
                     va chercher ce qu'on a remplacé. -->
                <filter name="inactive" string="Archivé"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_chair" string="Fauteuil"
                            domain="[]" context="{'group_by': 'chair_id'}"/>
                    <filter name="group_category" string="Famille"
                            domain="[]" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Le périmètre du cabinet, et pas la base entière.

         « Raccourci filtré » n'est pas une figure de style : sans
         domaine, cet écran montre TOUS les équipements de la base —
         l'imprimante de la réception, la camionnette du garage, le
         matériel d'une autre verticale — sous un menu dentaire qui
         promet le contraire. Le module frère (megga_dental_stock)
         borne chacune de ses actions par la catégorie du cabinet ;
         ici, le périmètre est le FAUTEUIL ou l'ÉQUIPE du cabinet.

         Dans un cabinet seul en base, le domaine ne retire rien : tout
         appartient à l'équipe « Cabinet ». Il ne coûte que le jour où
         une autre verticale partage la base — c'est-à-dire le jour où
         il compte.

         Le contexte pose l'équipe du cabinet par défaut : un appareil
         créé DEPUIS cet écran doit y rester visible après
         enregistrement, même sans fauteuil (le compresseur du local
         technique). Sans ce défaut, il disparaîtrait sous les yeux de
         celui qui vient de le saisir. -->
    <record id="action_dental_equipment" model="ir.actions.act_window">
        <field name="name">Matériel</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_dental_equipment_list"/>
        <field name="search_view_id" ref="view_dental_equipment_search"/>
        <field name="domain"
               eval="['|', ('chair_id', '!=', False),
                      ('maintenance_team_id', '=',
                       ref('maintenance_team_dental'))]"/>
        <field name="context"
               eval="{'search_default_group_chair': 1,
                      'default_maintenance_team_id':
                          ref('maintenance_team_dental')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun appareil au registre
            </p><p>
                Autoclave, compresseur, générateur de rayons X, unit :
                inscrivez ce qui se révise et se prouve, et rattachez-le
                au fauteuil qu'il sert.
            </p>
        </field>
    </record>

    <!-- Les demandes d'entretien : l'écran du cœur, borné au matériel
         qui porte un fauteuil OU qui appartient à l'équipe du cabinet.
         Aucun modèle de plus, aucun cycle de plus — mais un périmètre
         réellement posé, et non seulement annoncé.

         Le demandeur n'a pas à être pré-rempli : le cœur pose déjà
         `owner_user_id` sur l'utilisateur courant. Le contexte portait
         `default_user_id`, qui est le TECHNICIEN et non le demandeur —
         et que le compute du cœur écrase dès qu'un équipement est
         choisi. Un défaut faux et sans effet : retiré. Ce qui est posé
         par défaut, c'est l'équipe du cabinet, pour qu'une demande
         créée ici y reste visible.

         `search_default_active` écarte les demandes annulées : le
         filtre `active` existe bien dans la vue de recherche du cœur
         (un contexte sans filtre serait un contexte sans effet). -->
    <record id="action_dental_maintenance_request" model="ir.actions.act_window">
        <field name="name">Entretiens</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="view_id" ref="maintenance.hr_equipment_request_view_kanban"/>
        <!-- Le périmètre se lit sur l'APPAREIL, pas sur l'équipe de la
             demande : `maintenance_team_id` de la demande porte un
             `default=` du cœur (la première équipe de la société), et
             un défaut posé à la création court-circuite le compute qui
             aurait recopié l'équipe de l'appareil. Une panne signalée
             depuis l'app Maintenance serait donc tombée hors du
             périmètre alors qu'elle vise bien le compresseur du
             cabinet. Le troisième terme rattrape la demande SANS
             appareil — une demande générale du cabinet, la seule où
             son équipe à elle fait foi. -->
        <field name="domain"
               eval="['|', '|',
                      ('equipment_id.chair_id', '!=', False),
                      ('equipment_id.maintenance_team_id', '=',
                       ref('maintenance_team_dental')),
                      '&amp;', ('equipment_id', '=', False),
                      ('maintenance_team_id', '=',
                       ref('maintenance_team_dental'))]"/>
        <field name="context"
               eval="{'search_default_active': True,
                      'default_maintenance_team_id':
                          ref('maintenance_team_dental')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune demande d'entretien
            </p><p>
                Une panne se signale ici, et un entretien périodique
                (validation d'autoclave, révision du compresseur) se
                règle en demande <b>récurrente</b> : clore celle du
                trimestre engendre celle du suivant.
            </p>
        </field>
    </record>
</odoo>
