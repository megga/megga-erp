<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_category_dental" model="product.category">
            <field name="name">Soins dentaires</field>
        </record>

        <record id="mail_activity_dental_recall" model="mail.activity.type">
            <field name="name">Rappel de contrôle dentaire</field>
            <field name="res_model">megga.dental.patient</field>
            <field name="icon">fa-medkit</field>
        </record>

        <record id="ir_cron_dental_recall" model="ir.cron">
            <field name="name">Dentaire : rappels de contrôle</field>
            <field name="model_id" ref="model_megga_dental_patient"/>
            <field name="state">code</field>
            <field name="code">model._cron_dental_recalls()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
