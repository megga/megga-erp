<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- company_id explicitement vide : sans cela ir.sequence prend la
             société courante par défaut et next_by_code ne trouve plus la
             séquence depuis une autre société (multi-sociétés, tests). -->
        <record id="seq_dental_patient" model="ir.sequence">
            <field name="name">Patients du cabinet</field>
            <field name="code">megga.dental.patient</field>
            <field name="prefix">PAT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dental_treatment" model="ir.sequence">
            <field name="name">Traitements dentaires</field>
            <field name="code">megga.dental.treatment</field>
            <field name="prefix">TRT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dental_plan" model="ir.sequence">
            <field name="name">Plans de traitement</field>
            <field name="code">megga.dental.plan</field>
            <field name="prefix">PLAN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dental_insurance_case" model="ir.sequence">
            <field name="name">Dossiers d'assurance</field>
            <field name="code">megga.dental.insurance.case</field>
            <field name="prefix">CAS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dental_prescription" model="ir.sequence">
            <field name="name">Ordonnances</field>
            <field name="code">megga.dental.prescription</field>
            <field name="prefix">ORD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
