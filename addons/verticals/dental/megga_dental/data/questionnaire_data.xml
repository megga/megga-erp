<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Deux gabarits d'EXEMPLE, a adapter par le cabinet : une
             anamnese medicale usuelle (validite 24 mois) et un
             consentement au traitement des donnees (nLPD) — ce dernier
             rejoint la doctrine LPD du logiciel. Le consentement
             MEDICAL aux soins (extraction, implant...) reste a ecrire
             par le cabinet : son contenu engage le praticien. -->
        <record id="questionnaire_anamnese" model="megga.dental.questionnaire">
            <field name="name">Anamnèse médicale (exemple, à adapter)</field>
            <field name="kind">anamnese</field>
            <field name="validity_months">24</field>
            <field name="intro">Ces informations servent exclusivement à la sécurité de vos soins. Merci de répondre à chaque question ; votre praticien précisera avec vous les réponses positives.</field>
        </record>
        <record id="anamnese_q_allergies" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">10</field>
            <field name="name">Avez-vous des allergies (médicaments, latex, anesthésiques…) ?</field>
            <field name="note_on_yes" eval="True"/>
        </record>
        <record id="anamnese_q_anticoagulants" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">20</field>
            <field name="name">Prenez-vous des anticoagulants ou antiagrégants ?</field>
            <field name="note_on_yes" eval="True"/>
        </record>
        <record id="anamnese_q_coeur" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">30</field>
            <field name="name">Souffrez-vous d'une maladie cardiaque ou d'hypertension ?</field>
            <field name="note_on_yes" eval="True"/>
        </record>
        <record id="anamnese_q_diabete" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">40</field>
            <field name="name">Êtes-vous diabétique ?</field>
            <field name="note_on_yes" eval="True"/>
        </record>
        <record id="anamnese_q_medication" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">50</field>
            <field name="name">Prenez-vous des médicaments régulièrement ?</field>
            <field name="note_on_yes" eval="True"/>
        </record>
        <record id="anamnese_q_grossesse" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">60</field>
            <field name="name">Êtes-vous enceinte ou allaitez-vous ?</field>
        </record>
        <record id="anamnese_q_tabac" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">70</field>
            <field name="name">Fumez-vous ?</field>
        </record>
        <record id="anamnese_q_intervention" model="megga.dental.questionnaire.question">
            <field name="questionnaire_id" ref="questionnaire_anamnese"/>
            <field name="sequence">80</field>
            <field name="name">Avez-vous été hospitalisé(e) ou opéré(e) ces deux dernières années ?</field>
            <field name="note_on_yes" eval="True"/>
        </record>

        <record id="questionnaire_consent_lpd" model="megga.dental.questionnaire">
            <field name="name">Consentement au traitement des données (nLPD — exemple, à adapter)</field>
            <field name="kind">consent</field>
            <field name="intro">Je consens à ce que le cabinet traite mes données personnelles, y compris mes données de santé, aux seules fins de mes soins, de leur facturation et du suivi de mon dossier (art. 6 nLPD). L'accès est limité à l'équipe soignante selon son rôle ; mes données ne sont transmises qu'aux destinataires nécessaires (assureur, laboratoire) et je peux exercer mes droits d'accès et de rectification auprès du cabinet.</field>
        </record>
    </data>
</odoo>
