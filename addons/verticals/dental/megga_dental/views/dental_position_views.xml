<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_position_list" model="ir.ui.view">
        <field name="name">megga.dental.position.list</field>
        <field name="model">megga.dental.position</field>
        <field name="arch" type="xml">
            <list string="Positions tarifaires" editable="bottom" multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="points"/>
                <field name="chapter" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dental_position_search" model="ir.ui.view">
        <field name="name">megga.dental.position.search</field>
        <field name="model">megga.dental.position</field>
        <field name="arch" type="xml">
            <search string="Positions tarifaires">
                <field name="code"/>
                <field name="name"/>
                <field name="chapter"/>
                <filter name="inactive" string="Archivées"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_chapter" string="Chapitre"
                            context="{'group_by': 'chapter'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_position" model="ir.actions.act_window">
        <field name="name">Tarif par points</field>
        <field name="res_model">megga.dental.position</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Constituer le catalogue des positions</p>
            <p>Le catalogue officiel est sous licence SSO : importez vos
               positions (CSV : code, libellé, points, chapitre) ou
               saisissez-les ici. Le montant d'un acte vaut
               points × valeur du point du cabinet.</p>
        </field>
    </record>
    <record id="view_company_form_dental" model="ir.ui.view">
        <field name="name">res.company.form.dental</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Dentaire" name="dental">
                    <group>
                        <group>
                            <field name="dental_point_value"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
