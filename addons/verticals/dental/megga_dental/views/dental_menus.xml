        <field name="view_mode">list,form</field>
        <field name="domain"
               eval="[('categ_id', 'child_of', ref('product_category_dental'))]"/>
        <field name="context"
               eval="{'default_categ_id': ref('product_category_dental'), 'default_type': 'service'}"/>
    </record>
    <menuitem id="menu_dental_acts" name="Catalogue des actes"
