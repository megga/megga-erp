<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_dental_root" name="Dentaire" sequence="55"
              web_icon="megga_dental,static/description/icon.png"
              groups="megga_dental.group_dental_reception"/>

    <menuitem id="menu_dental_patients" name="Patients"
              parent="menu_dental_root" action="action_dental_patient"
              sequence="10"
              groups="megga_dental.group_dental_reception"/>
    <menuitem id="menu_dental_treatments" name="Traitements"
              parent="menu_dental_root" action="action_dental_treatment"
              sequence="20"
              groups="megga_dental.group_dental_reception"/>

    <menuitem id="menu_dental_plans" name="Plans de traitement"
              parent="menu_dental_root" action="action_dental_plan"
              sequence="25"
              groups="megga_dental.group_dental_reception"/>

    <!-- Le menu des constats vit ici (et non dans le fichier de vues) :
         menu_dental_root n'existe qu'une fois dental_menus.xml charge —
         meme ordre de chargement que le menu du tarif par points. -->
    <menuitem id="menu_dental_tooth_records" name="Constats"
              parent="menu_dental_root" action="action_dental_tooth_record"
              sequence="30"
              groups="megga_dental.group_dental_praticien"/>

    <menuitem id="menu_dental_config" name="Configuration"
              parent="menu_dental_root" sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_dental_positions" name="Tarif par points"
              parent="menu_dental_config" action="action_dental_position"
              sequence="5"/>

    <record id="action_dental_acts" model="ir.actions.act_window">
        <field name="name">Catalogue des actes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain"
               eval="[('categ_id', 'child_of', ref('product_category_dental'))]"/>
        <field name="context"
               eval="{'default_categ_id': ref('product_category_dental'), 'default_type': 'service'}"/>
    </record>
    <menuitem id="menu_dental_acts" name="Catalogue des actes"
              parent="menu_dental_config" action="action_dental_acts"
              sequence="10"/>
    <menuitem id="menu_dental_teeth" name="Dents (FDI)"
              parent="menu_dental_config" action="action_dental_tooth"
              sequence="20"/>
</odoo>
