<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupes LPD du cabinet. Les données de santé sont des données
         personnelles SENSIBLES (art. 5 let. c nLPD) : leur accès doit
         être proportionné (art. 6) et sécurisé (art. 8). Deux rôles :

         - Réception : identité, coordonnées, rendez-vous, traitements
           et facturation — JAMAIS le dossier médical ;
         - Soins : tout, dossier médical compris (implique Réception).

         La protection des champs médicaux est portée par groups= sur
         les champs eux-mêmes (appliquée par l'ORM, pas seulement par
         les vues) ; sans aucun groupe dentaire, aucun accès du tout. -->

    <record id="module_category_dentaire" model="ir.module.category">
        <field name="name">Dentaire</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_dentaire" model="res.groups.privilege">
        <field name="name">Dentaire</field>
        <field name="category_id" ref="module_category_dentaire"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_dental_reception" model="res.groups">
        <field name="name">Réception</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dentaire"/>
        <!-- group_partner_manager : le patient délègue son identité à
             res.partner — tenir les identités (téléphone, adresse,
             nouveaux contacts) est précisément le métier de la
             réception. -->
        <field name="implied_ids"
               eval="[(4, ref('base.group_user')),
                      (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Identité, coordonnées, rendez-vous et
facturation des patients — jamais le dossier médical (données sensibles,
art. 5 nLPD).</field>
    </record>

    <record id="group_dental_praticien" model="res.groups">
        <field name="name">Soins</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dentaire"/>
        <field name="implied_ids" eval="[(4, ref('group_dental_reception'))]"/>
        <field name="comment">Accès complet au dossier médical (allergies,
antécédents, médication, notes cliniques) et suppression de dossiers.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_dental_praticien'))]"/>
    </record>
</odoo>
