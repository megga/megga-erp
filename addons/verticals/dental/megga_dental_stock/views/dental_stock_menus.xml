<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le magasin sous le menu du cabinet : la réception et l'aide
         dentaire ne devraient pas avoir à traverser l'app Inventaire
         pour savoir s'il reste des compresses. Ce sont des RACCOURCIS
         vers des vues filtrées, pas un contournement d'ACL : les
         groupes du cœur (stock.group_stock_user / _manager) gardent
         chaque écran, et sans eux le menu ne s'affiche pas.

         Sous « Intendance » (megga_dental), aux côtés de la
         stérilisation et du registre du matériel : le magasin compte,
         la stérilisation prouve, le registre entretient. Séquence 10 :
         il vient en premier des trois, c'est lui qu'on ouvre le plus. -->
    <!-- LE CONTENEUR EST RE-DECLARE ICI, ET C'EST INDISPENSABLE.

         Il appartient a megga_dental (c'est son xml_id), mais un
         module ne monte JAMAIS sa dependance : `button_upgrade`
         (ir_module.py) ne parcourt que l'AVAL — les modules qui
         dependent de lui — et `update_list` se contente d'incrementer
         un compteur d'affichage quand la version du manifeste depasse
         celle en base, sans jamais toucher `state`. Un module reste
         « installed » ne rejoue pas ses donnees.

         Sans ce bloc, `-u megga_dental_stock` seul sur une base en
         service mourrait sur « External ID not found in the system:
         megga_dental.menu_dental_intendance » — et c'est justement le
         parcours prevu pour ce module.

         La declaration croisee est legale (`_test_xml_id`,
         odoo/tools/convert.py, n'exige que l'installation du module
         cite — megga_dental est une dependance dure) et idempotente :
         quand megga_dental monte dans la meme invocation il charge le
         menu en premier, et ce bloc le reecrit a l'identique. Le nom
         et la sequence sont verrouilles par un test, pour qu'une copie
         ne puisse pas deriver en silence. -->
    <menuitem id="megga_dental.menu_dental_intendance" name="Intendance"
              parent="megga_dental.menu_dental_root" sequence="40"/>

    <menuitem id="menu_dental_stock_root" name="Stock du cabinet"
              parent="megga_dental.menu_dental_intendance" sequence="10"
              groups="stock.group_stock_user"/>

    <menuitem id="menu_dental_stock_products" name="Consommables"
              parent="menu_dental_stock_root"
              action="action_dental_stock_product" sequence="10"
              groups="stock.group_stock_user"/>

    <!-- « À commander » suit le cœur, qui garde son propre menu
         « Replenishment » par stock.group_stock_manager : la vue est
         éditable et l'ACL du cœur ne donne l'écriture sur les règles
         qu'au responsable. L'ouvrir au magasinier simple lui montrerait
         une liste qu'il ne peut pas remplir. Les autres écrans du
         magasin, eux, restent à group_stock_user : ils se lisent. -->
    <menuitem id="menu_dental_stock_replenish" name="À commander"
              parent="menu_dental_stock_root"
              action="action_dental_replenishment" sequence="15"
              groups="stock.group_stock_manager"/>

    <menuitem id="menu_dental_stock_quants" name="Quantités en stock"
              parent="menu_dental_stock_root"
              action="action_dental_stock_quant" sequence="20"
              groups="stock.group_stock_user"/>

    <menuitem id="menu_dental_stock_lots" name="Lots et péremption"
              parent="menu_dental_stock_root"
              action="action_dental_stock_lot" sequence="30"
              groups="stock.group_stock_user"/>
</odoo>
