<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le tarif par points n'avait qu'une liste éditable : le kit de
         consommables demande une fiche. Le module apporte donc le
         formulaire qui lui manquait, et ouvre l'action existante
         dessus — l'acte et ce qu'il consomme se règlent au même
         endroit. -->
    <record id="view_dental_position_form" model="ir.ui.view">
        <field name="name">megga.dental.position.form</field>
        <field name="model">megga.dental.position</field>
        <field name="arch" type="xml">
            <form string="Position tarifaire">
                <sheet>
                    <div class="oe_title">
                        <label for="code" string="Numéro"/>
                        <h1><field name="code" placeholder="4.0100"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="points"/>
                        </group>
                        <group>
                            <field name="chapter"/>
                            <field name="condition"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consommables" name="supplies">
                            <field name="supply_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <!-- Les consommables du cabinet
                                         d'abord : le gabarit guide, il
                                         n'enferme pas — la restriction
                                         vit dans la vue, pas dans une
                                         contrainte. -->
                                    <field name="product_id"
                                           options="{'no_create': True}"
                                           domain="[('is_storable', '=', True),
                                                    ('categ_id', 'child_of',
                                                     %(megga_dental_stock.product_category_dental_supplies)d)]"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"
                                           options="{'no_create': True}"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Ce qu'un acte consomme au fauteuil. La
                                clôture de la séance le décompte du
                                magasin — deux actes qui partagent un
                                produit additionnent leurs besoins.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="megga_dental.action_dental_position" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

    <!-- Sur la séance : ce que le magasin a décompté. Un lien, pas un
         écran de plus — et il ne s'affiche que pour qui a le droit de
         lire le magasin. -->
    <record id="view_dental_treatment_form_supply" model="ir.ui.view">
        <field name="name">megga.dental.treatment.form.supply</field>
        <field name="model">megga.dental.treatment</field>
        <field name="inherit_id"
               ref="megga_dental.view_dental_treatment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_id']" position="after">
                <!-- Le booléen est visible de TOUS : la réception doit
                     savoir que le décompte a eu lieu sans avoir accès
                     au magasin. Le lien vers le transfert, lui, reste
                     réservé à qui a le droit de le lire. -->
                <field name="supply_done" readonly="1"
                       invisible="not supply_done"/>
                <field name="supply_picking_id" readonly="1"
                       invisible="not supply_picking_id"
                       groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>
</odoo>
