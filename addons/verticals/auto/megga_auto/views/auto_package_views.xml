<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_package_list" model="ir.ui.view">
        <field name="name">megga.auto.package.list</field>
        <field name="model">megga.auto.package</field>
        <field name="arch" type="xml">
            <list string="Forfaits d'atelier">
                <field name="name"/>
                <field name="price_estimate"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_auto_package_form" model="ir.ui.view">
        <field name="name">megga.auto.package.form</field>
        <field name="model">megga.auto.package</field>
        <field name="arch" type="xml">
            <form string="Forfait d'atelier">
                <sheet>
                    <widget name="web_ribbon" title="Archivé"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"
                                   placeholder="Service annuel, vidange, roues été/hiver…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="price_estimate"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="kind"/>
                            <field name="description"/>
                            <field name="product_id"
                                   invisible="kind == 'labor'"
                                   required="kind == 'part'"/>
                            <!-- invisible par LIGNE : une piece n'a pas
                                 d'heures, une main-d'oeuvre n'a pas de
                                 quantite — sans cela la liste affiche
                                 des 00:00 et des 1.00 qui ne veulent
                                 rien dire. -->
                            <field name="hours" widget="float_time"
                                   invisible="kind == 'part'"/>
                            <field name="quantity"
                                   invisible="kind == 'labor'"/>
                        </list>
                    </field>
                    <field name="note"
                           placeholder="Conditions, véhicules concernés…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auto_package" model="ir.actions.act_window">
        <field name="name">Forfaits d'atelier</field>
        <field name="res_model">megga.auto.package</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun forfait</p>
            <p>Les prestations types de l'atelier — vidange, service
               annuel, roues — en gabarits : heures de main-d'œuvre et
               pièces, posés sur un ordre de réparation en un clic, au
               taux horaire et aux prix du jour.</p>
        </field>
    </record>
    <!-- Le taux horaire vit sur la fiche Societe (meme patron que la
         valeur du point du cabinet dentaire) : sans cet heritage, le
         champ existerait sans etre atteignable a l'ecran — et le refus
         « renseignez le taux horaire atelier (fiche Societe) »
         renverrait vers un champ introuvable. -->
    <record id="view_company_form_auto" model="ir.ui.view">
        <field name="name">res.company.form.auto</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Garage" name="auto">
                    <group>
                        <group>
                            <field name="megga_labor_rate"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
