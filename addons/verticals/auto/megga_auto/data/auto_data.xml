<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_activity_auto_inspection" model="mail.activity.type">
            <field name="name">Expertise à préparer (OETV)</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="icon">fa-car</field>
        </record>

        <record id="ir_cron_auto_inspection" model="ir.cron">
            <field name="name">Garage : rappels d'expertise périodique</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_megga_inspections()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <!-- Le support de facturation de la main-d'oeuvre des forfaits :
             un service, prix pose au taux horaire de la societe au moment
             de l'application (list_price sans objet ici). -->
        <record id="product_labor" model="product.product">
            <field name="name">Main-d'œuvre atelier</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
        </record>
    </data>
</odoo>
