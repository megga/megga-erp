<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- company_id explicitement vide (leçon des verticales
             précédentes) : sans cela ir.sequence prend la société courante
             et next_by_code échoue depuis toute autre société. -->
        <record id="seq_auto_workorder" model="ir.sequence">
            <field name="name">Ordres de réparation</field>
            <field name="code">megga.auto.workorder</field>
            <field name="prefix">OR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
