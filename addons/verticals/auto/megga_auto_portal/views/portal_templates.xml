<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La carte d'accueil du portail. -->
    <template id="portal_my_home_auto" name="Portail : mon garage"
              inherit_id="portal.portal_my_home" customize_show="True"
              priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Mon garage</t>
                <t t-set="text">Véhicules, réparations et carnet d'entretien</t>
                <t t-set="url" t-value="'/my/vehicules'"/>
                <t t-set="placeholder_count" t-value="'auto_vehicle_count'"/>
            </t>
        </div>
    </template>

    <!-- Fil d'Ariane. -->
    <template id="portal_breadcrumbs_auto" name="Portail : fil garage"
              inherit_id="portal.portal_breadcrumbs" priority="45">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'auto_vehicles'"
                class="breadcrumb-item active">Mes véhicules</li>
            <li t-if="page_name == 'auto_workorders'"
                class="breadcrumb-item active">Mes réparations</li>
        </xpath>
    </template>

    <!-- Les onglets communs des deux pages. -->
    <template id="portal_auto_tabs">
        <div class="mb-3">
            <a href="/my/vehicules" t-attf-class="btn btn-sm me-1 #{'btn-primary' if page_name == 'auto_vehicles' else 'btn-outline-secondary'}">Véhicules</a>
            <a href="/my/reparations" t-attf-class="btn btn-sm #{'btn-primary' if page_name == 'auto_workorders' else 'btn-outline-secondary'}">Réparations</a>
        </div>
    </template>

    <template id="portal_my_vehicles" name="Mes véhicules">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <h3 class="mb-3">Mes véhicules</h3>
            <t t-call="megga_auto_portal.portal_auto_tabs"/>
            <p t-if="not vehicles">Aucun véhicule à votre nom au garage.</p>
            <div t-else="" class="table-responsive">
                <table class="table table-sm o_portal_my_doc_table">
                    <thead>
                        <tr>
                            <th>Véhicule</th>
                            <th>Plaque</th>
                            <th>Prochaine expertise</th>
                            <th class="text-end">Compteur</th>
                            <th class="text-end">Carnet</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="vehicles" t-as="vehicle">
                            <td t-esc="vehicle.model_id.display_name"/>
                            <td t-esc="vehicle.license_plate or ''"/>
                            <td>
                                <span t-if="vehicle.megga_next_inspection"
                                      t-field="vehicle.megga_next_inspection"/>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-end"
                                t-esc="'%.0f km' % vehicle.odometer"/>
                            <td class="text-end">
                                <a t-attf-href="/my/vehicules/#{vehicle.id}/carnet"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fa fa-download me-1"/>Carnet
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_my_workorders" name="Mes réparations">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <h3 class="mb-3">Mes réparations</h3>
            <t t-call="megga_auto_portal.portal_auto_tabs"/>
            <p t-if="not orders">Aucune réparation en cours ou terminée.</p>
            <div t-else="" class="table-responsive">
                <table class="table table-sm o_portal_my_doc_table">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Date</th>
                            <th>Véhicule</th>
                            <th>Travaux</th>
                            <th>État</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="orders" t-as="order">
                            <td t-esc="order.name"/>
                            <td><span t-field="order.date"/></td>
                            <td t-esc="order.vehicle_id.license_plate
                                       or order.vehicle_id.model_id.display_name"/>
                            <!-- description seulement : le catalogue du
                                 garage n'est pas ouvert au portail, et
                                 la designation est posee a la source. -->
                            <td t-esc="', '.join(
                                order.line_ids.mapped('description'))"/>
                            <td><span t-field="order.state"/></td>
                            <td class="text-end">
                                <span t-field="order.amount_total"
                                      t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
