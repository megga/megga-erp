<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rdv_booking_form_auto" model="ir.ui.view">
        <field name="name">megga.rdv.booking.form.auto</field>
        <field name="model">megga.rdv.booking</field>
        <field name="inherit_id" ref="megga_rdv.view_rdv_booking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_workorder" type="object"
                        string="Créer l'ordre de réparation"
                        class="btn-primary"
                        invisible="state != 'confirmed' or not vehicle_id or workorder_id"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="vehicle_id"/>
                <field name="workorder_id" invisible="not workorder_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_rdv_booking_list_auto" model="ir.ui.view">
        <field name="name">megga.rdv.booking.list.auto</field>
        <field name="model">megga.rdv.booking</field>
        <field name="inherit_id" ref="megga_rdv.view_rdv_booking_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='guest_name']" position="after">
                <field name="vehicle_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_rdv_type_form_auto" model="ir.ui.view">
        <field name="name">megga.rdv.type.form.auto</field>
        <field name="model">megga.rdv.type</field>
        <field name="inherit_id" ref="megga_rdv.view_rdv_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='horizon_days']" position="after">
                <field name="auto_vehicle_link"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_form_rdv" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.rdv</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rdv_bookings" type="object"
                        class="oe_stat_button" icon="fa-calendar">
                    <field name="rdv_booking_count" widget="statinfo"
                           string="RDV en ligne"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
