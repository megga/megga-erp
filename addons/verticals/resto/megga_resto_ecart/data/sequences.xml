<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- company_id explicitement vide : sans cela ir.sequence prend
             la societe courante et next_by_code echoue depuis toute
             autre societe (lecon de la verticale dentaire). -->
        <record id="seq_resto_ecart" model="ir.sequence">
            <field name="name">Relevés d'écart matière</field>
            <field name="code">megga.resto.ecart</field>
            <field name="prefix">ECA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
