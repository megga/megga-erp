<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resto_reservation_form" model="ir.ui.view">
        <field name="name">megga.resto.reservation.form</field>
        <field name="model">megga.resto.reservation</field>
        <field name="arch" type="xml">
            <form string="Réservation">
                <header>
                    <button name="action_confirm" type="object" string="Confirmer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_seat" type="object" string="Installer"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Clôturer"
                            class="btn-primary" invisible="state != 'seated'"/>
                    <button name="action_no_show" type="object" string="Non venus"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,seated,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="guest_name"/>
                            <field name="partner_id"/>
                            <field name="phone" widget="phone"/>
                            <field name="party_size"/>
                        </group>
                        <group string="Créneau">
                            <field name="start"/>
                            <field name="duration" widget="float_time"/>
                            <field name="stop"/>
                            <field name="table_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="seats_total"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes"
                           placeholder="Allergies, occasion, chaise haute…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_resto_reservation_list" model="ir.ui.view">
        <field name="name">megga.resto.reservation.list</field>
        <field name="model">megga.resto.reservation</field>
        <field name="arch" type="xml">
            <list string="Réservations">
                <field name="start"/>
                <field name="name"/>
                <field name="guest_name"/>
                <field name="party_size" sum="Couverts"/>
                <field name="table_ids" widget="many2many_tags"/>
                <field name="phone" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'seated'"
                       decoration-info="state == 'confirmed'"
                       decoration-danger="state == 'no_show'"
                       decoration-muted="state in ('cancelled', 'done')"/>
            </list>
        </field>
    </record>

    <record id="view_resto_reservation_calendar" model="ir.ui.view">
        <field name="name">megga.resto.reservation.calendar</field>
        <field name="model">megga.resto.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Réservations" date_start="start" date_stop="stop"
                      mode="week" quick_create="0" color="state">
                <field name="guest_name"/>
                <field name="party_size"/>
                <field name="table_ids" widget="many2many_tags"/>
            </calendar>
        </field>
    </record>

    <record id="view_resto_reservation_search" model="ir.ui.view">
        <field name="name">megga.resto.reservation.search</field>
        <field name="model">megga.resto.reservation</field>
        <field name="arch" type="xml">
            <search string="Réservations">
                <field name="guest_name"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <filter name="aujourdhui" string="Aujourd'hui"
                        domain="[('start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('start', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="a_venir" string="À venir"
                        domain="[('start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="state_confirmed" string="Confirmées"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_no_show" string="Non venus"
                        domain="[('state', '=', 'no_show')]"/>
                <group>
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Jour"
                            context="{'group_by': 'start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_resto_reservation" model="ir.actions.act_window">
        <field name="name">Réservations</field>
        <field name="res_model">megga.resto.reservation</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_a_venir': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Prendre une première réservation</p>
            <p>Le carnet s'adosse aux tables du plan de salle du POS :
               conflits de créneaux détectés, clients non venus marqués
               automatiquement.</p>
        </field>
    </record>
</odoo>
