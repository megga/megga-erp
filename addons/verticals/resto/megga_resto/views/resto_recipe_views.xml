<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resto_recipe_form" model="ir.ui.view">
        <field name="name">megga.resto.recipe.form</field>
        <field name="model">megga.resto.recipe</field>
        <field name="arch" type="xml">
            <form string="Fiche technique">
                <header>
                    <button name="action_apply_cost" type="object"
                            string="Reporter le coût sur l'article"
                            class="btn-secondary"
                            confirm="Remplacer le prix de revient de l'article par le coût matière calculé ?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="product_id"/>
                        <h1><field name="product_id"/></h1>
                    </div>
                    <group>
                        <group string="Économie du plat">
                            <field name="sale_price"/>
                            <field name="cost_total"/>
                            <field name="food_cost" widget="percentpie"/>
                        </group>
                        <group string="Marge">
                            <field name="margin"/>
                            <field name="margin_pct"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"
                                   options="{'no_create': True}"/>
                            <field name="allowed_uom_ids"
                                   column_invisible="1"/>
                            <field name="cost" sum="Coût matière"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="notes"
                           placeholder="Progression, dressage, allergènes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_resto_recipe_list" model="ir.ui.view">
        <field name="name">megga.resto.recipe.list</field>
        <field name="model">megga.resto.recipe</field>
        <field name="arch" type="xml">
            <list string="Fiches techniques">
                <field name="product_id"/>
                <field name="sale_price"/>
                <field name="cost_total"/>
                <field name="food_cost"/>
                <field name="margin_pct"/>
            </list>
        </field>
    </record>

    <record id="action_resto_recipe" model="ir.actions.act_window">
        <field name="name">Fiches techniques</field>
        <field name="res_model">megga.resto.recipe</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer une première fiche technique</p>
            <p>Ingrédients par portion, coût matière, marge — et report du
               coût sur l'article vendu en un clic.</p>
        </field>
    </record>

    <record id="view_restaurant_table_list_megga" model="ir.ui.view">
        <field name="name">restaurant.table.list.megga</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list string="Tables">
                <field name="floor_id"/>
                <field name="table_number"/>
                <field name="seats"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_resto_tables" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_restaurant_table_list_megga"/>
    </record>
</odoo>
