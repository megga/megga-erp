<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- E-mails, gabarit complet : le bloc « Powered by Odoo » est
         le div t-if="show_footer" (vérifié au SHA épinglé) -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout" name="Megga — e-mail sans promotion">
        <xpath expr="//div[@t-if='show_footer']" position="replace"/>
    </template>

    <!-- E-mails, gabarit léger : la ligne <tr> qui porte le lien promotionnel -->
    <template id="mail_notification_light" inherit_id="mail.mail_notification_light" name="Megga — e-mail léger sans promotion">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]/ancestor::tr[1]" position="replace"/>
    </template>

</odoo>
